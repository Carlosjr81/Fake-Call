# Generate a random key with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# Export variables in your process manager. Never commit a real key.
JARVIS_TOKEN=
JARVIS_BIND=127.0.0.1
JARVIS_DATA=./data
PORT=8080
# Optional OpenVoice model setup; without it relay and voice reference storage work.
# OPENVOICE_CONFIG=/absolute/checkpoints_v2/converter/config.json
# OPENVOICE_CHECKPOINT=/absolute/checkpoints_v2/converter/checkpoint.pth
# OPENVOICE_DEVICE=cuda:0

# Optional PSTN bridge — paid carrier service, disabled by default.
ENABLE_TELEPHONY=false
# Credentials stay on the server, never in the APK.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
JARVIS_PUBLIC_URL=
JARVIS_INCOMING_ROOM=telefone-pessoal
# Explicit list of allowed outbound numbers in E.164, separated by commas.
JARVIS_ALLOWED_NUMBERS=
PHONE_TIME_LIMIT=120
